# Copy to .env and fill in the two keys. Every variable the app reads is listed here.
# Vite inlines VITE_* at build time — these are not runtime secrets (see worker/ for the key broker).

# --- Required ---

# Speech-to-text. https://console.deepgram.com/
VITE_DEEPGRAM_API_KEY=

# LLM interpreter: "deepinfra" or "mock" (mock needs no key).
VITE_LLM_PROVIDER=deepinfra
# Required when VITE_LLM_PROVIDER=deepinfra. https://deepinfra.com/dash/api_keys
VITE_DEEPINFRA_API_KEY=

# --- Optional (defaults shown) ---

# VITE_DEEPINFRA_MODEL=Qwen/Qwen2.5-72B-Instruct
# VITE_LLM_REQUEST_TIMEOUT_MS=60000
# VITE_LLM_GET_ACTIONS_TIMEOUT_MS=90000
# VITE_LLM_LOG_FULL_PROMPTS=false

# VITE_DEEPGRAM_MODEL=nova-3
# VITE_DEEPGRAM_LANGUAGE=es
# VITE_DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen

# End-of-speech tuning for the post-wake command capture.
# VITE_STT_ENDPOINTING_MS=700
# VITE_STT_UTTERANCE_END_MS=1000
# Set to false to re-enable sound effects and habitat ambience during STT.
# VITE_STT_MUTE_NON_TTS_AUDIO=true

# "es-AR" (default) or "en-US".
# VITE_LOCALE=es-AR

# Show the export-logs button in the production UI.
# VITE_SHOW_EXPORT_BUTTON=false
# Allow "/pos <n>" teleport on the debug route. Leave off in production builds.
# VITE_DEBUG_POSITION_TELEPORT=false
